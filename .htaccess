# ══════════════════════════════════════════
#  Torcy Healthcare — Hostinger .htaccess
# ══════════════════════════════════════════

Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ── Force HTTPS (SSL activate karne ke baad uncomment karo) ──
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Default index file ────────────────────────────────────────
DirectoryIndex index.php index.html

# ── Block includes/ folder direct access ─────────────────────
RewriteRule ^includes/ - [F,L]

# ── GZIP Compression (site fast hogi) ────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript image/svg+xml
</IfModule>

# ── Browser Caching ───────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png         "access plus 6 months"
    ExpiresByType image/jpeg        "access plus 6 months"
    ExpiresByType image/gif         "access plus 6 months"
    ExpiresByType image/webp        "access plus 6 months"
    ExpiresByType image/x-icon      "access plus 1 year"
    ExpiresByType text/css          "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# ── Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# ── Custom Error Pages ────────────────────────────────────────
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
